<div class="relative overflow-hidden rounded-xl border border-[#28AFCB]/30 bg-[#012938]/75 p-3">
  <svg
    role="img"
    aria-label="Gráfico vectorial futurista de rutas conectadas y pines de geolocalización para TaxiYa"
    viewBox="0 0 420 200"
    fill="none"
    class="h-auto w-full"
  >
    <defs>
      <linearGradient id="taxiya-route-grad" x1="58" y1="146" x2="362" y2="56" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#28AFCB" />
        <stop offset="55%" stop-color="#F0F9FF" />
        <stop offset="100%" stop-color="#FF3D8E" />
      </linearGradient>
      <linearGradient id="taxiya-alt-grad" x1="60" y1="60" x2="355" y2="155" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#28AFCB" stop-opacity="0.65" />
        <stop offset="100%" stop-color="#FF3D8E" stop-opacity="0.45" />
      </linearGradient>
      <radialGradient id="taxiya-radar-cyan" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#28AFCB" stop-opacity="0.42" />
        <stop offset="100%" stop-color="#28AFCB" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="taxiya-radar-magenta" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FF3D8E" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#FF3D8E" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Urban coordinate grid -->
    <g stroke="#28AFCB" stroke-opacity="0.14" stroke-width="1">
      <line x1="0" y1="40" x2="420" y2="40" />
      <line x1="0" y1="80" x2="420" y2="80" />
      <line x1="0" y1="120" x2="420" y2="120" />
      <line x1="0" y1="160" x2="420" y2="160" />
      <line x1="60" y1="0" x2="60" y2="200" />
      <line x1="140" y1="0" x2="140" y2="200" />
      <line x1="220" y1="0" x2="220" y2="200" />
      <line x1="300" y1="0" x2="300" y2="200" />
      <line x1="380" y1="0" x2="380" y2="200" />
    </g>

    <!-- Diagonal urban blocks / streets -->
    <g stroke="#28AFCB" stroke-opacity="0.2" stroke-width="1">
      <path d="M24 176 L112 88 L220 88 L302 22" />
      <path d="M98 184 L178 132 L292 132 L392 78" />
    </g>

    <!-- Geolocation radar rings -->
    <circle cx="76" cy="144" r="46" fill="url(#taxiya-radar-cyan)" />
    <circle cx="76" cy="144" r="28" stroke="#28AFCB" stroke-opacity="0.35" stroke-dasharray="3 4" />

    <circle cx="344" cy="58" r="48" fill="url(#taxiya-radar-magenta)" />
    <circle cx="344" cy="58" r="30" stroke="#FF3D8E" stroke-opacity="0.4" stroke-dasharray="3 4" />

    <!-- Secondary alternative route -->
    <path
      d="M76 144 C118 72, 198 54, 248 92 C282 118, 314 102, 344 58"
      stroke="url(#taxiya-alt-grad)"
      stroke-width="1.5"
      stroke-dasharray="4 6"
    />

    <!-- Primary active mobility route -->
    <path
      d="M76 144 C132 144, 152 106, 212 104 C272 102, 294 62, 344 58"
      stroke="url(#taxiya-route-grad)"
      stroke-width="3"
      stroke-linecap="round"
    />

    <!-- Origin pin (Passenger - Turquoise) -->
    <g>
      <circle cx="76" cy="144" r="10" fill="#012E3F" stroke="#28AFCB" stroke-width="2.2" />
      <circle cx="76" cy="144" r="4" fill="#FFFFFF" />
    </g>

    <!-- Active driver relay node in transit -->
    <g>
      <circle cx="212" cy="104" r="14" fill="#014E6A" stroke="#28AFCB" stroke-width="2" />
      <path d="M217.5 104 L207.5 99 L210.2 104 L207.5 109 Z" fill="#FF3D8E" transform="rotate(-14 212 104)" />
    </g>

    <!-- Waypoint node -->
    <circle cx="278" cy="82" r="4.5" fill="#012E3F" stroke="#28AFCB" stroke-width="1.8" />
    <circle cx="144" cy="126" r="4" fill="#012E3F" stroke="#FF3D8E" stroke-width="1.8" />

    <!-- Destination geolocation pin (Magenta) -->
    <g>
      <path
        d="M344 26 C332.5 26 323 35.4 323 47 C323 61.5 344 82 344 82 C344 82 365 61.5 365 47 C365 35.4 355.5 26 344 26 Z"
        fill="#014E6A"
        stroke="#FF3D8E"
        stroke-width="2.2"
      />
      <circle cx="344" cy="47" r="7" fill="#FF3D8E" />
      <circle cx="344" cy="47" r="2.8" fill="#FFFFFF" />
    </g>

    <!-- Minimal HUD corner brackets -->
    <g stroke="#28AFCB" stroke-opacity="0.55" stroke-width="1.5">
      <path d="M12 24 V12 H24" />
      <path d="M396 12 H408 V24" />
      <path d="M12 176 V188 H24" />
      <path d="M396 188 H408 V176" />
    </g>
  </svg>
</div>
