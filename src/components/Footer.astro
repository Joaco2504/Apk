---
import { SITE_INFO } from '../data/site';
---

<footer class="relative z-10 border-t border-[#28afcb]/20 bg-[#013144]/65 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-8 text-sm text-[#f0f9ff]/80 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="space-y-1">
      <p class="font-medium text-white">{SITE_INFO.copyright}</p>
      <p class="text-xs text-[#f0f9ff]/75">{SITE_INFO.location}</p>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm">
      <a
        href={`mailto:${SITE_INFO.email}`}
        class="text-[#f0f9ff] transition-colors hover:text-[#28afcb] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] focus-visible:rounded"
      >
        {SITE_INFO.email}
      </a>
      <a
        href="/privacidad"
        class="font-medium text-[#28afcb] transition-colors hover:text-[#ff3d8e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] focus-visible:rounded"
      >
        Política de privacidad
      </a>
    </div>
  </div>
</footer>
