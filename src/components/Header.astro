---
import { NAV_ITEMS, SITE_INFO } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-[#28afcb]/20 bg-[#014e6a]/55 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4 sm:px-6">
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] focus-visible:rounded-md"
    >
      <span
        aria-hidden="true"
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#28afcb]/35 bg-[#012e3f]/80 transition-colors group-hover:border-[#ff3d8e]/70"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
          <path
            d="M6 17L12 6L18 15"
            stroke="url(#header-node-grad)"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="6" cy="17" r="2.2" fill="#28AFCB" />
          <circle cx="12" cy="6" r="2.2" fill="#FFFFFF" />
          <circle cx="18" cy="15" r="2.2" fill="#FF3D8E" />
          <defs>
            <linearGradient id="header-node-grad" x1="6" y1="6" x2="18" y2="17" gradientUnits="userSpaceOnUse">
              <stop stop-color="#28AFCB" />
              <stop offset="1" stop-color="#FF3D8E" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="font-display text-base font-semibold tracking-tight sm:text-lg">
        {SITE_INFO.brandName}
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-7 sm:flex">
      {
        NAV_ITEMS.map((item) => {
          const isPrivacyActive = item.href === '/privacidad' && currentPath === '/privacidad';
          return (
            <a
              href={item.href}
              aria-current={isPrivacyActive ? 'page' : undefined}
              class:list={[
                'rounded px-1 py-0.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb]',
                isPrivacyActive
                  ? 'text-[#28afcb]'
                  : 'text-[#f0f9ff]/90 hover:text-[#28afcb]',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Abrir menú"
      class="inline-flex items-center justify-center rounded-lg border border-[#28afcb]/35 bg-[#01384d]/75 p-2 text-[#f0f9ff] transition-colors hover:border-[#28afcb] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] sm:hidden"
    >
      <svg id="icon-menu-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-menu-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav-panel"
    class="hidden border-t border-[#28afcb]/20 bg-[#01384d]/92 px-5 py-3 backdrop-blur-md sm:hidden"
  >
    <nav aria-label="Navegación móvil" class="flex flex-col gap-1">
      {
        NAV_ITEMS.map((item) => {
          const isPrivacyActive = item.href === '/privacidad' && currentPath === '/privacidad';
          return (
            <a
              href={item.href}
              data-mobile-nav-link
              aria-current={isPrivacyActive ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                isPrivacyActive
                  ? 'bg-[#28afcb]/15 text-[#28afcb]'
                  : 'text-[#f0f9ff] hover:bg-[#014e6a]/70 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');
  const mobileLinks = document.querySelectorAll('[data-mobile-nav-link]');

  if (toggleBtn && mobilePanel && iconOpen && iconClose) {
    const setMenuOpen = (open: boolean) => {
      toggleBtn.setAttribute('aria-expanded', String(open));
      toggleBtn.setAttribute(
        'aria-label',
        open ? 'Cerrar menú' : 'Abrir menú',
      );
      mobilePanel.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>
