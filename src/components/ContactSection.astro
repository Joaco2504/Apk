---
import { SITE_INFO } from '../data/site';
---

<section
  id="contacto"
  aria-labelledby="contacto-heading"
  class="border-t border-[#28afcb]/20 py-16 sm:py-24"
>
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <div class="glass-surface rounded-2xl p-6 sm:p-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-5">
          <p class="font-mono text-xs font-medium tracking-widest text-[#ff3d8e] uppercase">
            Desarrollador
          </p>
          <h2
            id="contacto-heading"
            class="mt-2 font-display text-2xl font-bold tracking-tight text-white sm:text-3xl"
          >
            Contacto
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#f0f9ff]/90 sm:text-base">
            Si usás alguna de nuestras aplicaciones o revisás los datos de desarrollador para Google Play, escribí directo por correo.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-7">
          <div class="glass-inner rounded-xl p-5 sm:col-span-2">
            <p class="font-mono text-xs text-[#28afcb]">Correo</p>
            <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
              <a
                href={`mailto:${SITE_INFO.email}`}
                class="break-all font-mono text-base font-medium text-white transition-colors hover:text-[#28afcb] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] focus-visible:rounded sm:text-lg"
              >
                {SITE_INFO.email}
              </a>

              <button
                type="button"
                data-copy-email={SITE_INFO.email}
                class="inline-flex items-center gap-2 rounded-lg border border-[#28afcb]/45 bg-[#014e6a]/70 px-3.5 py-2 text-xs font-medium text-white transition-colors hover:border-[#ff3d8e] hover:bg-[#ff3d8e]/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb]"
              >
                <svg
                  data-copy-icon
                  aria-hidden="true"
                  class="h-3.5 w-3.5 text-[#28afcb]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                <svg
                  data-check-icon
                  aria-hidden="true"
                  class="hidden h-3.5 w-3.5 text-[#28afcb]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span data-copy-label>Copiar correo</span>
              </button>
            </div>
            <p
              id="copy-email-feedback"
              role="status"
              aria-live="polite"
              class="mt-2 min-h-4 text-xs text-[#28afcb] opacity-0 transition-opacity"
            ></p>
          </div>

          <div class="glass-inner rounded-xl p-5">
            <p class="font-mono text-xs text-[#28afcb]">Responsable</p>
            <p class="mt-2 text-base font-semibold text-white">{SITE_INFO.developerName}</p>
            <p class="mt-1 text-xs text-[#f0f9ff]/80">{SITE_INFO.roleFull}</p>
          </div>

          <div class="glass-inner rounded-xl p-5">
            <p class="font-mono text-xs text-[#28afcb]">Ubicación</p>
            <p class="mt-2 text-base font-semibold text-white">{SITE_INFO.location}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const feedbackEl = document.getElementById('copy-email-feedback');

  if (copyButton) {
    const labelEl = copyButton.querySelector<HTMLElement>('[data-copy-label]');
    const copyIcon = copyButton.querySelector<SVGElement>('[data-copy-icon]');
    const checkIcon = copyButton.querySelector<SVGElement>('[data-check-icon]');
    let resetTimer: number | undefined;

    const copyTextFallback = (text: string): boolean => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      let copied = false;
      try {
        const legacyExec = Reflect.get(document, 'execCommand');
        copied = typeof legacyExec === 'function' ? Boolean(legacyExec.call(document, 'copy')) : false;
      } catch {
        copied = false;
      }
      document.body.removeChild(textarea);
      return copied;
    };

    const showCopiedState = (succeeded: boolean) => {
      window.clearTimeout(resetTimer);
      if (succeeded) {
        if (labelEl) labelEl.textContent = 'Copiado';
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (feedbackEl) {
          feedbackEl.textContent = 'Correo copiado.';
          feedbackEl.classList.remove('opacity-0', 'text-[#ff3d8e]');
          feedbackEl.classList.add('opacity-100', 'text-[#28afcb]');
        }
      } else if (feedbackEl) {
        feedbackEl.textContent =
          'No pudimos copiar el correo porque el navegador bloqueó el portapapeles. Seleccionalo arriba para copiarlo a mano.';
        feedbackEl.classList.remove('opacity-0', 'text-[#28afcb]');
        feedbackEl.classList.add('opacity-100', 'text-[#ff3d8e]');
      }

      resetTimer = window.setTimeout(() => {
        if (labelEl) labelEl.textContent = 'Copiar correo';
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (feedbackEl) {
          feedbackEl.classList.remove('opacity-100');
          feedbackEl.classList.add('opacity-0');
        }
      }, 2600);
    };

    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.copyEmail;
      if (!email) return;

      let copied = false;
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(email);
          copied = true;
        } catch {
          copied = copyTextFallback(email);
        }
      } else {
        copied = copyTextFallback(email);
      }

      showCopiedState(copied);
    });
  }
</script>
