<canvas
  id="node-network-canvas"
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 h-full w-full opacity-85"
></canvas>

<script>
  interface NetworkNode {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    isHub: boolean;
  }

  interface EdgeSignal {
    fromIndex: number;
    toIndex: number;
    progress: number;
    speed: number;
  }

  const canvasEl = document.getElementById('node-network-canvas');

  if (canvasEl instanceof HTMLCanvasElement) {
    const heroSection = canvasEl.closest('[data-hero-section]');
    const ctx = canvasEl.getContext('2d');

    if (ctx) {
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const palette = ['#06B6D4', '#8B5CF6', '#94A3B8'] as const;

      let width = 0;
      let height = 0;
      let dpr = 1;
      let nodes: NetworkNode[] = [];
      let signal: EdgeSignal | null = null;
      let animationFrameId: number | null = null;
      let isInView = true;

      const pointer = {
        x: 0,
        y: 0,
        active: false,
      };

      const getNodeCount = (w: number, h: number): number => {
        const area = w * h;
        return Math.max(26, Math.min(54, Math.round(area / 17000)));
      };

      const createNodes = (w: number, h: number): NetworkNode[] => {
        const count = getNodeCount(w, h);
        const list: NetworkNode[] = [];

        for (let i = 0; i < count; i += 1) {
          const isHub = i % 7 === 0;
          const color =
            i % 3 === 0 ? palette[0] : i % 3 === 1 ? palette[1] : palette[2];
          const speedBase = isHub ? 0.16 : 0.24;
          const angle = Math.random() * Math.PI * 2;
          const speed = speedBase * (0.55 + Math.random() * 0.75);

          list.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            radius: isHub ? 2.4 : 1.4 + Math.random() * 0.8,
            color,
            isHub,
          });
        }

        return list;
      };

      const pickSignal = (maxDist: number): EdgeSignal | null => {
        if (nodes.length < 2) return null;
        for (let attempt = 0; attempt < 18; attempt += 1) {
          const a = Math.floor(Math.random() * nodes.length);
          const b = Math.floor(Math.random() * nodes.length);
          if (a === b) continue;
          const dx = nodes[a].x - nodes[b].x;
          const dy = nodes[a].y - nodes[b].y;
          const dist = Math.hypot(dx, dy);
          if (dist > 45 && dist < maxDist) {
            return {
              fromIndex: a,
              toIndex: b,
              progress: 0,
              speed: 0.012 + Math.random() * 0.01,
            };
          }
        }
        return null;
      };

      const resizeCanvas = () => {
        const parent = canvasEl.parentElement;
        if (!parent) return;

        const rect = parent.getBoundingClientRect();
        width = Math.max(1, Math.floor(rect.width));
        height = Math.max(1, Math.floor(rect.height));
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvasEl.width = Math.floor(width * dpr);
        canvasEl.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        nodes = createNodes(width, height);
        signal = null;
      };

      const drawFrame = (animate: boolean) => {
        ctx.clearRect(0, 0, width, height);

        const maxDist = width < 640 ? 128 : 168;
        const pointerDist = 175;

        if (animate) {
          for (const node of nodes) {
            node.x += node.vx;
            node.y += node.vy;

            if (node.x < -12) node.x = width + 12;
            else if (node.x > width + 12) node.x = -12;

            if (node.y < -12) node.y = height + 12;
            else if (node.y > height + 12) node.y = -12;
          }
        }

        // Draw subtle connections between neighboring nodes
        ctx.lineWidth = 1;
        for (let i = 0; i < nodes.length; i += 1) {
          const a = nodes[i];

          for (let j = i + 1; j < nodes.length; j += 1) {
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const dist = Math.hypot(dx, dy);

            if (dist < maxDist) {
              const ratio = 1 - dist / maxDist;
              const alpha = ratio * 0.22;
              const usesViolet = a.color === '#8B5CF6' || b.color === '#8B5CF6';
              ctx.strokeStyle = usesViolet
                ? `rgba(139, 92, 246, ${alpha.toFixed(3)})`
                : `rgba(6, 182, 212, ${alpha.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }

          // Subtle interactive pointer links
          if (pointer.active) {
            const pdx = a.x - pointer.x;
            const pdy = a.y - pointer.y;
            const pdist = Math.hypot(pdx, pdy);

            if (pdist < pointerDist) {
              const pAlpha = (1 - pdist / pointerDist) * 0.28;
              ctx.strokeStyle = `rgba(6, 182, 212, ${pAlpha.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(pointer.x, pointer.y);
              ctx.stroke();
            }
          }
        }

        // Draw subtle travelling packet along an active edge
        if (animate) {
          if (!signal) {
            if (Math.random() < 0.04) {
              signal = pickSignal(maxDist);
            }
          } else {
            const fromNode = nodes[signal.fromIndex];
            const toNode = nodes[signal.toIndex];
            const dist = Math.hypot(fromNode.x - toNode.x, fromNode.y - toNode.y);

            if (dist > maxDist * 1.15 || signal.progress >= 1) {
              signal = null;
            } else {
              const sx = fromNode.x + (toNode.x - fromNode.x) * signal.progress;
              const sy = fromNode.y + (toNode.y - fromNode.y) * signal.progress;

              ctx.fillStyle = 'rgba(248, 250, 252, 0.78)';
              ctx.beginPath();
              ctx.arc(sx, sy, 1.5, 0, Math.PI * 2);
              ctx.fill();

              signal.progress += signal.speed;
            }
          }
        }

        // Draw nodes
        for (const node of nodes) {
          if (node.isHub) {
            ctx.fillStyle =
              node.color === '#8B5CF6'
                ? 'rgba(139, 92, 246, 0.14)'
                : 'rgba(6, 182, 212, 0.14)';
            ctx.beginPath();
            ctx.arc(node.x, node.y, node.radius * 3.4, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.globalAlpha = node.isHub ? 0.72 : 0.45;
          ctx.fillStyle = node.color;
          ctx.beginPath();
          ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      };

      const tick = () => {
        if (!isInView || document.hidden || reducedMotionQuery.matches) {
          animationFrameId = null;
          return;
        }
        drawFrame(true);
        animationFrameId = window.requestAnimationFrame(tick);
      };

      const startLoop = () => {
        if (reducedMotionQuery.matches) {
          drawFrame(false);
          return;
        }
        if (animationFrameId === null && isInView && !document.hidden) {
          animationFrameId = window.requestAnimationFrame(tick);
        }
      };

      const stopLoop = () => {
        if (animationFrameId !== null) {
          window.cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      };

      resizeCanvas();
      startLoop();

      if (heroSection instanceof HTMLElement) {
        heroSection.addEventListener(
          'pointermove',
          (event) => {
            if (event.pointerType !== 'mouse') return;
            const rect = canvasEl.getBoundingClientRect();
            pointer.x = event.clientX - rect.left;
            pointer.y = event.clientY - rect.top;
            pointer.active = true;
          },
          { passive: true },
        );

        heroSection.addEventListener(
          'pointerleave',
          () => {
            pointer.active = false;
          },
          { passive: true },
        );

        const observer = new IntersectionObserver(
          (entries) => {
            isInView = entries[0]?.isIntersecting ?? true;
            if (isInView) {
              startLoop();
            } else {
              stopLoop();
            }
          },
          { threshold: 0.05 },
        );
        observer.observe(heroSection);
      }

      if (typeof ResizeObserver !== 'undefined' && canvasEl.parentElement) {
        let resizeTimer: number | undefined;
        const resizeObserver = new ResizeObserver(() => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            resizeCanvas();
            if (reducedMotionQuery.matches) {
              drawFrame(false);
            }
          }, 120);
        });
        resizeObserver.observe(canvasEl.parentElement);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopLoop();
        } else {
          startLoop();
        }
      });

      reducedMotionQuery.addEventListener('change', () => {
        if (reducedMotionQuery.matches) {
          stopLoop();
          drawFrame(false);
        } else {
          startLoop();
        }
      });
    }
  }
</script>
