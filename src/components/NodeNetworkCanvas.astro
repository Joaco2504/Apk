<canvas
  id="node-network-canvas"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-0 h-full w-full"
></canvas>

<script>
  type NodeTone = 'turquoise' | 'magenta' | 'ice';

  interface NetworkNode {
    x: number;
    y: number;
    vx: number;
    vy: number;
    baseVx: number;
    baseVy: number;
    radius: number;
    tone: NodeTone;
    isEnergy: boolean;
  }

  interface EdgeSignal {
    fromIndex: number;
    toIndex: number;
    progress: number;
    speed: number;
  }

  interface PulseWave {
    x: number;
    y: number;
    radius: number;
    maxRadius: number;
    alpha: number;
  }

  const canvasEl = document.getElementById('node-network-canvas');

  if (canvasEl instanceof HTMLCanvasElement) {
    const ctx = canvasEl.getContext('2d');

    if (ctx) {
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const colorMap: Record<NodeTone, string> = {
        turquoise: '#28AFCB',
        magenta: '#FF3D8E',
        ice: '#F0F9FF',
      };

      let width = 0;
      let height = 0;
      let dpr = 1;
      let nodes: NetworkNode[] = [];
      let signal: EdgeSignal | null = null;
      let waves: PulseWave[] = [];
      let animationFrameId: number | null = null;

      const pointer = {
        x: 0,
        y: 0,
        active: false,
      };

      const getNodeCount = (w: number, h: number): number => {
        const area = w * h;
        return Math.max(34, Math.min(78, Math.round(area / 19000)));
      };

      const createNodes = (w: number, h: number): NetworkNode[] => {
        const count = getNodeCount(w, h);
        const list: NetworkNode[] = [];

        for (let i = 0; i < count; i += 1) {
          const isEnergy = i % 5 === 0;
          const tone: NodeTone = isEnergy
            ? 'magenta'
            : i % 4 === 0
              ? 'ice'
              : 'turquoise';
          const speedBase = isEnergy ? 0.2 : 0.28;
          const angle = Math.random() * Math.PI * 2;
          const speed = speedBase * (0.55 + Math.random() * 0.75);
          const baseVx = Math.cos(angle) * speed;
          const baseVy = Math.sin(angle) * speed;

          list.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: baseVx,
            vy: baseVy,
            baseVx,
            baseVy,
            radius: isEnergy ? 2.6 : 1.5 + Math.random() * 0.9,
            tone,
            isEnergy,
          });
        }

        return list;
      };

      const pickSignal = (maxDist: number): EdgeSignal | null => {
        if (nodes.length < 2) return null;
        for (let attempt = 0; attempt < 20; attempt += 1) {
          const a = Math.floor(Math.random() * nodes.length);
          const b = Math.floor(Math.random() * nodes.length);
          if (a === b) continue;
          const dist = Math.hypot(nodes[a].x - nodes[b].x, nodes[a].y - nodes[b].y);
          if (dist > 45 && dist < maxDist) {
            return {
              fromIndex: a,
              toIndex: b,
              progress: 0,
              speed: 0.015 + Math.random() * 0.012,
            };
          }
        }
        return null;
      };

      const resizeCanvas = () => {
        const prevWidth = width;
        const prevHeight = height;
        const rect = canvasEl.getBoundingClientRect();
        const nextWidth = Math.max(1, Math.round(rect.width || window.innerWidth));
        const nextHeight = Math.max(1, Math.round(rect.height || window.innerHeight));

        width = nextWidth;
        height = nextHeight;
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvasEl.width = Math.floor(width * dpr);
        canvasEl.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (nodes.length === 0 || prevWidth === 0 || prevHeight === 0) {
          nodes = createNodes(width, height);
        } else {
          const scaleX = width / prevWidth;
          const scaleY = height / prevHeight;
          for (const node of nodes) {
            node.x *= scaleX;
            node.y *= scaleY;
          }
        }
        signal = null;
      };

      const applyClickWave = (originX: number, originY: number) => {
        if (reducedMotionQuery.matches) return;

        waves.push({
          x: originX,
          y: originY,
          radius: 8,
          maxRadius: width < 640 ? 190 : 260,
          alpha: 0.8,
        });

        const repulseRadius = width < 640 ? 190 : 250;
        for (const node of nodes) {
          const dx = node.x - originX;
          const dy = node.y - originY;
          const dist = Math.hypot(dx, dy);
          if (dist < repulseRadius) {
            const safeDist = Math.max(12, dist);
            const force = (1 - dist / repulseRadius) * 6.5;
            node.vx += (dx / safeDist) * force;
            node.vy += (dy / safeDist) * force;
          }
        }
      };

      const drawFrame = (animate: boolean) => {
        ctx.clearRect(0, 0, width, height);

        const maxDist = width < 640 ? 128 : 168;
        const magnetRadius = width < 640 ? 150 : 210;

        if (animate) {
          for (const node of nodes) {
            if (pointer.active) {
              const mdx = pointer.x - node.x;
              const mdy = pointer.y - node.y;
              const mdist = Math.hypot(mdx, mdy);

              if (mdist < magnetRadius && mdist > 1) {
                const proximity = 1 - mdist / magnetRadius;
                if (mdist > 44) {
                  node.vx += (mdx / mdist) * proximity * 0.26;
                  node.vy += (mdy / mdist) * proximity * 0.26;
                } else {
                  // Elastic orbital tension close to the pointer
                  node.vx += (-mdy / mdist) * 0.08;
                  node.vy += (mdx / mdist) * 0.08;
                  if (mdist < 24) {
                    node.vx -= (mdx / mdist) * 0.14;
                    node.vy -= (mdy / mdist) * 0.14;
                  }
                }
              }
            }

            // Smooth spring return to autonomous drift velocity
            node.vx = node.vx * 0.94 + node.baseVx * 0.06;
            node.vy = node.vy * 0.94 + node.baseVy * 0.06;

            const speed = Math.hypot(node.vx, node.vy);
            if (speed > 8.5) {
              node.vx = (node.vx / speed) * 8.5;
              node.vy = (node.vy / speed) * 8.5;
            }

            node.x += node.vx;
            node.y += node.vy;

            if (node.x < -16) node.x = width + 16;
            else if (node.x > width + 16) node.x = -16;

            if (node.y < -16) node.y = height + 16;
            else if (node.y > height + 16) node.y = -16;
          }
        }

        // Draw node-to-node links
        for (let i = 0; i < nodes.length; i += 1) {
          const a = nodes[i];

          for (let j = i + 1; j < nodes.length; j += 1) {
            const b = nodes[j];
            const dist = Math.hypot(a.x - b.x, a.y - b.y);

            if (dist < maxDist) {
              const ratio = 1 - dist / maxDist;
              let alpha = ratio * 0.28;
              let isMagnetBoosted = false;

              if (pointer.active) {
                const pa = Math.hypot(a.x - pointer.x, a.y - pointer.y);
                const pb = Math.hypot(b.x - pointer.x, b.y - pointer.y);
                if (pa < magnetRadius || pb < magnetRadius) {
                  alpha = Math.min(0.55, alpha + 0.18 * ratio);
                  isMagnetBoosted = true;
                }
              }

              const usesMagenta = a.isEnergy && b.isEnergy;
              const mixedEnergy = (a.isEnergy || b.isEnergy) && isMagnetBoosted;

              ctx.lineWidth = isMagnetBoosted ? 1.2 : 1;
              if (usesMagenta) {
                ctx.strokeStyle = `rgba(255, 61, 142, ${alpha.toFixed(3)})`;
              } else if (mixedEnergy) {
                ctx.strokeStyle = `rgba(255, 61, 142, ${(alpha * 0.85).toFixed(3)})`;
              } else {
                ctx.strokeStyle = `rgba(40, 175, 203, ${alpha.toFixed(3)})`;
              }

              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }

          // Bright magnetic cursor connections
          if (pointer.active) {
            const pdist = Math.hypot(a.x - pointer.x, a.y - pointer.y);
            if (pdist < magnetRadius) {
              const pRatio = 1 - pdist / magnetRadius;
              const pAlpha = pRatio * 0.58;
              ctx.lineWidth = a.isEnergy ? 1.45 : 1.15;
              ctx.strokeStyle = a.isEnergy
                ? `rgba(255, 61, 142, ${pAlpha.toFixed(3)})`
                : `rgba(40, 175, 203, ${pAlpha.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(pointer.x, pointer.y);
              ctx.stroke();
            }
          }
        }

        // Draw expanding click shockwaves
        if (animate && waves.length > 0) {
          const remainingWaves: PulseWave[] = [];
          for (const wave of waves) {
            wave.radius += 7.2;
            wave.alpha *= 0.92;

            if (wave.radius < wave.maxRadius && wave.alpha > 0.03) {
              ctx.lineWidth = 1.6;
              ctx.strokeStyle = `rgba(255, 61, 142, ${wave.alpha.toFixed(3)})`;
              ctx.beginPath();
              ctx.arc(wave.x, wave.y, wave.radius, 0, Math.PI * 2);
              ctx.stroke();

              if (wave.radius > 18) {
                ctx.lineWidth = 1;
                ctx.strokeStyle = `rgba(40, 175, 203, ${(wave.alpha * 0.75).toFixed(3)})`;
                ctx.beginPath();
                ctx.arc(wave.x, wave.y, wave.radius * 0.72, 0, Math.PI * 2);
                ctx.stroke();
              }

              remainingWaves.push(wave);
            }
          }
          waves = remainingWaves;
        }

        // Draw travelling energy packet along active edge
        if (animate) {
          if (!signal) {
            if (Math.random() < 0.05) {
              signal = pickSignal(maxDist);
            }
          } else {
            const fromNode = nodes[signal.fromIndex];
            const toNode = nodes[signal.toIndex];
            const dist = Math.hypot(fromNode.x - toNode.x, fromNode.y - toNode.y);

            if (dist > maxDist * 1.2 || signal.progress >= 1) {
              signal = null;
            } else {
              const sx = fromNode.x + (toNode.x - fromNode.x) * signal.progress;
              const sy = fromNode.y + (toNode.y - fromNode.y) * signal.progress;

              ctx.fillStyle = 'rgba(255, 61, 142, 0.35)';
              ctx.beginPath();
              ctx.arc(sx, sy, 4.5, 0, Math.PI * 2);
              ctx.fill();

              ctx.fillStyle = '#FFFFFF';
              ctx.beginPath();
              ctx.arc(sx, sy, 1.6, 0, Math.PI * 2);
              ctx.fill();

              signal.progress += signal.speed;
            }
          }
        }

        // Draw magnetic pointer halo
        if (pointer.active && animate) {
          ctx.fillStyle = 'rgba(40, 175, 203, 0.14)';
          ctx.beginPath();
          ctx.arc(pointer.x, pointer.y, 16, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = 'rgba(255, 61, 142, 0.85)';
          ctx.beginPath();
          ctx.arc(pointer.x, pointer.y, 2.4, 0, Math.PI * 2);
          ctx.fill();
        }

        // Draw nodes
        for (const node of nodes) {
          if (node.isEnergy) {
            ctx.fillStyle = 'rgba(255, 61, 142, 0.18)';
            ctx.beginPath();
            ctx.arc(node.x, node.y, node.radius * 3.4, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.globalAlpha = node.isEnergy ? 0.9 : node.tone === 'ice' ? 0.65 : 0.72;
          ctx.fillStyle = colorMap[node.tone];
          ctx.beginPath();
          ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      };

      const tick = () => {
        if (document.hidden || reducedMotionQuery.matches) {
          animationFrameId = null;
          return;
        }
        drawFrame(true);
        animationFrameId = window.requestAnimationFrame(tick);
      };

      const startLoop = () => {
        if (reducedMotionQuery.matches) {
          drawFrame(false);
          return;
        }
        if (animationFrameId === null && !document.hidden) {
          animationFrameId = window.requestAnimationFrame(tick);
        }
      };

      const stopLoop = () => {
        if (animationFrameId !== null) {
          window.cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      };

      resizeCanvas();
      startLoop();

      window.addEventListener(
        'pointermove',
        (event) => {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.active = true;
        },
        { passive: true },
      );

      window.addEventListener(
        'pointerdown',
        (event) => {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.active = true;
          applyClickWave(event.clientX, event.clientY);
        },
        { passive: true },
      );

      document.addEventListener(
        'mouseleave',
        () => {
          pointer.active = false;
        },
        { passive: true },
      );

      window.addEventListener(
        'blur',
        () => {
          pointer.active = false;
        },
        { passive: true },
      );

      let resizeTimer: number | undefined;
      const scheduleResize = () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resizeCanvas();
          if (reducedMotionQuery.matches) {
            drawFrame(false);
          }
        }, 80);
      };

      window.addEventListener('resize', scheduleResize);

      if (typeof ResizeObserver !== 'undefined') {
        const resizeObserver = new ResizeObserver(scheduleResize);
        resizeObserver.observe(canvasEl);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopLoop();
        } else {
          startLoop();
        }
      });

      reducedMotionQuery.addEventListener('change', () => {
        if (reducedMotionQuery.matches) {
          stopLoop();
          drawFrame(false);
        } else {
          startLoop();
        }
      });
    }
  }
</script>
