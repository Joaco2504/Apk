---
import { PROJECTS } from '../data/site';
---

<section id="proyectos" aria-labelledby="proyectos-heading" class="py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <div class="mb-10 max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-widest text-cyan-400 uppercase">
        Desarrollo propio
      </p>
      <h2
        id="proyectos-heading"
        class="mt-2 font-display text-3xl font-bold tracking-tight text-[#f8fafc] sm:text-4xl"
      >
        Aplicaciones y Proyectos
      </h2>
      <p class="mt-3 text-base text-slate-400">
        Aplicaciones móviles y prototipos funcionales creados bajo Geti Soluciones.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        PROJECTS.map((project) => {
          const isCyan = project.accent === 'cyan';
          return (
            <article class="glass-surface project-card flex flex-col justify-between rounded-2xl p-6 sm:p-7">
              <div>
                <div class="flex items-start justify-between gap-4">
                  <div
                    aria-hidden="true"
                    class:list={[
                      'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border',
                      isCyan
                        ? 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300'
                        : 'border-violet-500/30 bg-violet-500/10 text-violet-300',
                    ]}
                  >
                    {project.id === 'taxiya' ? (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="6" cy="18" r="2.5" />
                        <circle cx="18" cy="6" r="2.5" />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M8.2 16.5C11 14 10 10 15.8 7.5"
                        />
                        <circle cx="17" cy="17" r="1.5" fill="currentColor" stroke="none" opacity="0.6" />
                      </svg>
                    ) : (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="4" y="4" width="6" height="6" rx="1.5" />
                        <rect x="14" y="4" width="6" height="6" rx="1.5" />
                        <rect x="9" y="14" width="6" height="6" rx="1.5" />
                        <path stroke-linecap="round" d="M7 10v2.5c0 .8.7 1.5 1.5 1.5H12m5-4v2.5c0 .8-.7 1.5-1.5 1.5H12" />
                      </svg>
                    )}
                  </div>

                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs font-medium',
                      isCyan
                        ? 'border-cyan-400/30 bg-cyan-500/10 text-cyan-300'
                        : 'border-violet-400/30 bg-violet-500/10 text-violet-300',
                    ]}
                  >
                    <span
                      aria-hidden="true"
                      class:list={[
                        'h-1.5 w-1.5 rounded-full',
                        isCyan ? 'bg-cyan-400' : 'bg-violet-400',
                      ]}
                    />
                    {project.badge}
                  </span>
                </div>

                <h3 class="mt-6 font-display text-xl font-semibold tracking-tight text-[#f8fafc] sm:text-2xl">
                  {project.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">
                  {project.description}
                </p>
              </div>

              <div class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-slate-800/80 pt-4">
                <span class="font-mono text-xs text-slate-400">{project.domainLabel}</span>
                {project.id === 'taxiya' && (
                  <a
                    href="/privacidad"
                    class="text-xs font-medium text-cyan-400 transition-colors hover:text-cyan-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400/70 focus-visible:rounded"
                  >
                    Política de privacidad
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
