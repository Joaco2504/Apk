---
import TaxiYaRouteGraphic from './TaxiYaRouteGraphic.astro';
import { PROJECTS } from '../data/site';
---

<section id="proyectos" aria-labelledby="proyectos-heading" class="py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <div class="mb-10 max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-widest text-[#28afcb] uppercase">
        En marcha
      </p>
      <h2
        id="proyectos-heading"
        class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl"
      >
        Aplicaciones
      </h2>
      <p class="mt-3 text-base text-[#f0f9ff]/85">
        Apps de Geti Soluciones que estamos armando para Android.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      {
        PROJECTS.map((project) => {
          const isTaxiYa = project.id === 'taxiya';
          const isMagenta = project.accent === 'magenta';
          return (
            <article
              class:list={[
                'glass-surface project-card flex flex-col justify-between rounded-2xl p-6 sm:p-7',
                isTaxiYa ? 'lg:col-span-7' : 'lg:col-span-5',
              ]}
            >
              <div>
                <div class="flex items-start justify-between gap-4">
                  <div
                    aria-hidden="true"
                    class:list={[
                      'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border',
                      isMagenta
                        ? 'border-[#ff3d8e]/45 bg-[#ff3d8e]/15 text-[#ff3d8e]'
                        : 'border-[#28afcb]/45 bg-[#28afcb]/15 text-[#28afcb]',
                    ]}
                  >
                    {isTaxiYa ? (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="6" cy="18" r="2.5" />
                        <circle cx="18" cy="6" r="2.5" />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M8.2 16.5C11 14 10 10 15.8 7.5"
                        />
                        <circle cx="17" cy="17" r="1.5" fill="currentColor" stroke="none" opacity="0.7" />
                      </svg>
                    ) : (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="4" y="4" width="6" height="6" rx="1.5" />
                        <rect x="14" y="4" width="6" height="6" rx="1.5" />
                        <rect x="9" y="14" width="6" height="6" rx="1.5" />
                        <path stroke-linecap="round" d="M7 10v2.5c0 .8.7 1.5 1.5 1.5H12m5-4v2.5c0 .8-.7 1.5-1.5 1.5H12" />
                      </svg>
                    )}
                  </div>

                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs font-medium',
                      isMagenta
                        ? 'border-[#ff3d8e]/60 bg-[#ff3d8e]/20 text-white shadow-sm shadow-[#ff3d8e]/20'
                        : 'border-[#28afcb]/45 bg-[#28afcb]/15 text-[#f0f9ff]',
                    ]}
                  >
                    <span
                      aria-hidden="true"
                      class:list={[
                        'h-1.5 w-1.5 rounded-full',
                        isMagenta ? 'bg-[#ff3d8e]' : 'bg-[#28afcb]',
                      ]}
                    />
                    {project.badge}
                  </span>
                </div>

                <h3 class="mt-6 font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">
                  {project.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-[#f0f9ff]/90 sm:text-base">
                  {project.description}
                </p>

                {isTaxiYa ? (
                  <div class="mt-5">
                    <TaxiYaRouteGraphic />
                  </div>
                ) : (
                  <dl class="glass-inner mt-6 space-y-3 rounded-xl p-4 text-xs sm:text-sm">
                    <div class="flex items-center justify-between gap-3">
                      <dt class="font-mono text-xs text-[#28afcb]">Etapa</dt>
                      <dd class="font-medium text-white">Pruebas internas</dd>
                    </div>
                    <div class="flex items-center justify-between gap-3 border-t border-[#28afcb]/15 pt-3">
                      <dt class="font-mono text-xs text-[#28afcb]">Destino</dt>
                      <dd class="font-medium text-white">Google Play</dd>
                    </div>
                  </dl>
                )}
              </div>

              <div class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-[#28afcb]/20 pt-4">
                <span class="font-mono text-xs text-[#f0f9ff]/75">{project.domainLabel}</span>
                {isTaxiYa && (
                  <a
                    href="/privacidad"
                    class="text-xs font-medium text-[#28afcb] transition-colors hover:text-[#ff3d8e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28afcb] focus-visible:rounded"
                  >
                    Política de privacidad
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
